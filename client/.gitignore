# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# This project uses pnpm — see "packageManager" in package.json. A stray
# package-lock.json from someone running `npm install` gives CI a second,
# divergent source of truth for the dependency tree. Ignored so it cannot be
# committed by accident.
package-lock.json
yarn.lock
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
# Note: deliberately NOT ignoring "build" — Next.js outputs to .next, and
# src/app/(app)/build is a real route segment. An ignore entry for it makes
# Turbopack's watcher skip those routes and they 404 in dev.

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
