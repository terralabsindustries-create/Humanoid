# Copy to .env and fill in. .env is gitignored — never commit real secrets.

NODE_ENV=development
PORT=4000

# Local Postgres, created by: brew install postgresql@16
DATABASE_URL="postgresql://humanoid:humanoid_dev_password@localhost:5432/humanoid_dev"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-me"
COOKIE_SECRET="replace-me"

# Where the frontend runs. Must match exactly (scheme + host + port) for
# cross-origin cookies to be accepted.
# Comma-separated. Add the fallback port too: if something else already holds
# 3000, the Next dev server moves to 3001 and a single origin breaks CORS.
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# No email provider is wired up yet (see lib/notifications). In development
# this exposes the OTP code directly in the API response instead of pretending
# an email was sent — never enable in production.
EXPOSE_OTP_IN_RESPONSE=true

# --- Twilio inbound speech test (all optional; leave blank to skip) ---------
#
# Public https origin Twilio can reach. In development: `ngrok http 4000` and
# paste the forwarding URL here, with no trailing slash. This must match the
# webhook URL in the Twilio Console exactly, or signature validation fails.
PUBLIC_BASE_URL=

# Console > Account > API keys & tokens > Auth Token. Webhook signatures are
# HMAC'd with the Auth Token — an API key secret will NOT validate them.
TWILIO_AUTH_TOKEN=

# Console > Account info. Optional; when set, webhooks whose AccountSid does
# not match are rejected.
TWILIO_ACCOUNT_SID=

TWILIO_PHONE_NUMBER=+17372508034

# BCP-47 tag Twilio transcribes with. "en-IN" is more accurate for
# Indian-English callers than the "en-US" default.
TWILIO_SPEECH_LANGUAGE=en-US

# --- Realtime voice: Twilio ConversationRelay ---------------------------------
#
# Twilio holds one WebSocket open for the whole call and owns BOTH speech
# recognition and text-to-speech. This backend exchanges JSON *text* with it —
# audio never transits this process, which is why there is no ElevenLabs API
# key here — and there is no ElevenLabs key in the Twilio Console either.
# ElevenLabs is a first-party ConversationRelay TTS provider: Twilio holds the
# relationship and bills the usage.
#
# Set to false to fall back to the older synchronous <Gather> loop, which uses
# Twilio's built-in TTS and has no barge-in.
VOICE_RELAY_ENABLED=true

# Passed straight through as <ConversationRelay ttsProvider>. "ElevenLabs"
# "Google" and "Amazon" are the other options. None need a credential.
TWILIO_TTS_PROVIDER=ElevenLabs

# Which voice Twilio asks ElevenLabs for. An identifier, NOT a credential.
# Copy it from the ElevenLabs voice library. Blank omits the attribute and
# lets Twilio pick its default ElevenLabs voice.
ELEVENLABS_VOICE_ID=

# Optional. Appended as "<voiceId>-<modelId>". flash_v2_5 is already
# ConversationRelay's default and is the low-latency model a phone call wants;
# flash_v2, turbo_v2_5 and turbo_v2 are the alternatives. Per-voice tuning
# rides the same string, which is concatenated verbatim:
#   ELEVENLABS_MODEL_ID=flash_v2_5-0.8_0.8_0.6   (speed_stability_similarity)
ELEVENLABS_MODEL_ID=flash_v2_5

# Optional overrides for the transcription side. Blank uses Twilio's defaults.
TWILIO_TRANSCRIPTION_PROVIDER=
TWILIO_SPEECH_MODEL=

# How eagerly Twilio treats caller speech as a barge-in: low | medium | high.
VOICE_RELAY_INTERRUPT_SENSITIVITY=medium

# Signs the short-lived token binding a relay socket to one CallSid and tenant.
# Blank falls back to COOKIE_SECRET, which is fine — set it only to rotate
# voice tokens independently of session cookies.
VOICE_RELAY_TOKEN_SECRET=

# Hangs up after this many caller turns, so a forgotten call can't run forever.
VOICE_RELAY_MAX_TURNS=50

# Pause between the employee's farewell and actually hanging up. Twilio does
# not document whether ending a session lets pending speech finish, so this
# starts at 0 and wants measuring on a real call: if "Have a lovely day" comes
# out as "Have a lovely—", raise it until it doesn't.
VOICE_RELAY_HANGUP_DELAY_MS=0

# --- AI receptionist: the model behind the voice (optional) ------------------
#
# Without a key the phone line still answers and transcribes, it just doesn't
# reply — see backend/README.md § AI receptionist.
#
# "openai" here means the OpenAI *wire format*, not OpenAI the company. Groq
# serves that format, and on a phone call its inference speed is the whole
# point: time-to-first-token is what the caller experiences as dead air.
# Key: https://console.groq.com → API keys
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Latency dial, not a quality one. A reasoning model writes its private
# thinking before its first spoken word and the caller sits in silence for all
# of it. Set "none" on a reasoning model (Groq accepts it; qwen3.6-27b goes
# from ~320ms to ~130ms time-to-first-spoken-token). Leave blank otherwise.
LLM_REASONING_EFFORT=

# Only read when LLM_PROVIDER=anthropic. Kept for the <Gather> fallback path.
# Key: https://platform.claude.com → Settings → API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Deployment-wide fallback for calls to a number no workspace owns. Prefer
# assigning the number itself (workspaces.phone_number) — that is what makes
# routing correct with more than one tenant. Blank falls back again, to the
# most recently configured employee anywhere, which is a dev convenience and
# will answer as the wrong business the moment a second tenant onboards.
AI_EMPLOYEE_WORKSPACE_ID=

# ─── Usage metering ──────────────────────────────────────────────────────────
#
# These are rates, not bills. Twilio invoices the telephony and the model
# provider invoices the tokens; neither invoice is readable from inside this
# process. What *is* readable is how long each call was connected and how many
# tokens it burned, and /govern/usage multiplies those by the rates below —
# then says on the screen that it did exactly that.
#
# The defaults are in the right order of magnitude for a UK number on
# ConversationRelay with a small hosted model. They are nobody's real price
# list. Set them from your own bills.

# Minor units (pence/cents) per connected minute. Covers the whole telephony
# leg — inbound voice, speech recognition and speech synthesis — because Twilio
# bills those together and this system cannot separate them.
USAGE_RATE_VOICE_PER_MINUTE=9

# Minor units per million tokens. Priced separately because every provider
# prices them separately, usually by a factor of five or more.
USAGE_RATE_MODEL_INPUT_PER_MTOKEN=8
USAGE_RATE_MODEL_OUTPUT_PER_MTOKEN=40

# Asks the model provider to report token counts alongside the stream
# (`stream_options.include_usage`). Turn it off only for an OpenAI-compatible
# endpoint that rejects unknown parameters outright — the cost is losing the
# model half of the meter, which is then recorded as "not counted" rather than
# being allowed to read as free.
USAGE_METER_TOKENS=true
