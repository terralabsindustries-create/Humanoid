# Copy to .env and fill in. .env is gitignored — never commit real secrets.

NODE_ENV=development
PORT=4000

# Local Postgres, created by: brew install postgresql@16
DATABASE_URL="postgresql://humanoid:humanoid_dev_password@localhost:5432/humanoid_dev"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-me"
COOKIE_SECRET="replace-me"

# Where the frontend runs. Must match exactly (scheme + host + port) for
# cross-origin cookies to be accepted.
# Comma-separated. Add the fallback port too: if something else already holds
# 3000, the Next dev server moves to 3001 and a single origin breaks CORS.
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# No email provider is wired up yet (see lib/notifications). In development
# this exposes the OTP code directly in the API response instead of pretending
# an email was sent — never enable in production.
EXPOSE_OTP_IN_RESPONSE=true

# --- Twilio inbound speech test (all optional; leave blank to skip) ---------
#
# Public https origin Twilio can reach. In development: `ngrok http 4000` and
# paste the forwarding URL here, with no trailing slash. This must match the
# webhook URL in the Twilio Console exactly, or signature validation fails.
PUBLIC_BASE_URL=

# Console > Account > API keys & tokens > Auth Token. Webhook signatures are
# HMAC'd with the Auth Token — an API key secret will NOT validate them.
TWILIO_AUTH_TOKEN=

# Console > Account info. Optional; when set, webhooks whose AccountSid does
# not match are rejected.
TWILIO_ACCOUNT_SID=

TWILIO_PHONE_NUMBER=+17372508034

# BCP-47 tag Twilio transcribes with. "en-IN" is more accurate for
# Indian-English callers than the "en-US" default.
TWILIO_SPEECH_LANGUAGE=en-US

# --- Realtime voice: Twilio ConversationRelay ---------------------------------
#
# Twilio holds one WebSocket open for the whole call and owns BOTH speech
# recognition and text-to-speech. This backend exchanges JSON *text* with it —
# audio never transits this process, which is why there is no ElevenLabs API
# key here. The ElevenLabs credential is configured on the Twilio account
# (Console → Voice → Settings → Text to Speech), not here.
#
# Set to false to fall back to the older synchronous <Gather> loop, which uses
# Twilio's built-in TTS and has no barge-in.
VOICE_RELAY_ENABLED=true

# Passed straight through as <ConversationRelay ttsProvider>. "ElevenLabs"
# requires the credential above; "Google" and "Amazon" need no extra setup.
TWILIO_TTS_PROVIDER=ElevenLabs

# Which voice Twilio asks ElevenLabs for. An identifier, NOT a credential —
# the ElevenLabs API key lives on the Twilio account, never here. Blank omits
# the attribute and lets Twilio pick the provider default.
ELEVENLABS_VOICE_ID=

# Optional. Combined with the voice id as "<voiceId>-<modelId>". Flash models
# are the low-latency ones, which is what a phone call wants; flash_v2_5 is
# already ConversationRelay's ElevenLabs default.
ELEVENLABS_MODEL_ID=flash_v2_5

# Optional overrides for the transcription side. Blank uses Twilio's defaults.
TWILIO_TRANSCRIPTION_PROVIDER=
TWILIO_SPEECH_MODEL=

# How eagerly Twilio treats caller speech as a barge-in: low | medium | high.
VOICE_RELAY_INTERRUPT_SENSITIVITY=medium

# Signs the short-lived token binding a relay socket to one CallSid and tenant.
# Blank falls back to COOKIE_SECRET, which is fine — set it only to rotate
# voice tokens independently of session cookies.
VOICE_RELAY_TOKEN_SECRET=

# Hangs up after this many caller turns, so a forgotten call can't run forever.
VOICE_RELAY_MAX_TURNS=50

# --- AI receptionist: the model behind the voice (optional) ------------------
#
# Without a key the phone line still answers and transcribes, it just doesn't
# reply — see backend/README.md § AI receptionist.
#
# "openai" here means the OpenAI *wire format*, not OpenAI the company. Groq
# serves that format, and on a phone call its inference speed is the whole
# point: time-to-first-token is what the caller experiences as dead air.
# Key: https://console.groq.com → API keys
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Only read when LLM_PROVIDER=anthropic. Kept for the <Gather> fallback path.
# Key: https://platform.claude.com → Settings → API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Which onboarded workspace's AI employee answers the number. Stopgap until a
# phone-number → workspace mapping exists; blank means "most recently
# configured employee", which is fine with one tenant and wrong with two.
AI_EMPLOYEE_WORKSPACE_ID=
